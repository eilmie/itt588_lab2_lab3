<% content_for :title, "Hotline | Break the Silence" %>

<h1 class="mb-3">Emergency & Support Hotlines</h1>
<p class="lead">If you or someone you know is in immediate danger, call <strong>999</strong> right away.</p>

<div class="row g-4 mt-2 hotline-card">

  <div class="col-12">
    <div class="card border-danger border-2 shadow">
      <div class="card-body text-center">
        <h3 class="text-danger">Emergency (Police)</h3>
        <p class="mb-3">Available 24 hours</p>
        <a href="tel:999" class="btn btn-danger btn-lg">Call 999</a>
      </div>
    </div>
  </div>

  <div class="col-12 col-md-6">
    <div class="card h-100 shadow-sm">
      <div class="card-body">
        <h4>Talian Kasih</h4>
        <p class="text-muted">Ministry of Women, Family and Community Development</p>
        <p>24-hour national helpline for domestic violence and child abuse.</p>
        <a href="tel:15999" class="btn btn-primary mb-2 w-100">Call 15999</a>
        <a href="https://wa.me/60192615999" class="btn btn-outline-success w-100">WhatsApp 019-261 5999</a>
      </div>
    </div>
  </div>

  <div class="col-12 col-md-6">
    <div class="card h-100 shadow-sm">
      <div class="card-body">
        <h4>Women's Aid Organisation (WAO)</h4>
        <p class="text-muted">Free and confidential crisis support, 24 hours</p>
        <a href="tel:+60330008858" class="btn btn-primary mb-2 w-100">Call +603 3000 8858</a>
        <a href="https://wa.me/60189888058" class="btn btn-outline-success w-100">WhatsApp TINA 018-988 8058</a>
      </div>
    </div>
  </div>

  <div class="col-12 col-md-6">
    <div class="card h-100 shadow-sm">
      <div class="card-body">
        <h4>All Women's Action Society (AWAM)</h4>
        <p class="text-muted">Counselling and support for women</p>
        <a href="https://wa.me/60162374221" class="btn btn-outline-success w-100">WhatsApp 016-237 4221</a>
      </div>
    </div>
  </div>

  <div class="col-12 col-md-6">
    <div class="card h-100 shadow-sm">
      <div class="card-body">
        <h4>Befrienders Kuala Lumpur</h4>
        <p class="text-muted">Emotional support, 24 hours</p>
        <a href="tel:+60376272929" class="btn btn-primary w-100">Call 03-7627 2929</a>
      </div>
    </div>
  </div>

</div>

<div class="alert alert-warning mt-4">
  <strong>Safety tip:</strong> If your device may be monitored, use the red <strong>Quick Exit</strong> button
  in the menu and clear your browsing history afterwards.
</div>

<p class="small text-muted">Numbers were last checked in October 2026. Please confirm on each organisation's official website.</p>