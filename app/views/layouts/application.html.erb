<!DOCTYPE html>
<html lang="en">
<head>
  <title><%= content_for(:title) || "Break the Silence | GBV Support in Malaysia" %></title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Poppins:wght@600;700&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  <%= javascript_importmap_tags %>
</head>

<body class="d-flex flex-column min-vh-100" data-turbo="false">
  <a href="https://www.google.com" class="btn btn-danger quick-exit"><i class="bi bi-box-arrow-up-right"></i> Quick Exit</a>

  <nav class="navbar navbar-expand-lg navbar-dark bg-purple sticky-top">
    <div class="container">
      <%= link_to "Break the Silence", root_path, class: "navbar-brand fw-bold" %>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
      </button>

      <div class="collapse navbar-collapse" id="mainNav">
        <ul class="navbar-nav ms-auto align-items-lg-center">
          <li class="nav-item"><%= link_to "What Is", what_is_path, class: "nav-link #{'active' if current_page?(what_is_path) || current_page?(root_path)}" %></li>
          <li class="nav-item"><%= link_to "Contact", contact_path, class: "nav-link #{'active' if current_page?(contact_path)}" %></li>
          <li class="nav-item"><%= link_to "Law Enforcement", law_enforcement_path, class: "nav-link #{'active' if current_page?(law_enforcement_path)}" %></li>
          <li class="nav-item"><%= link_to "Enforcer", enforcer_path, class: "nav-link #{'active' if current_page?(enforcer_path)}" %></li>
          <li class="nav-item"><%= link_to "Hotline", hotline_path, class: "nav-link #{'active' if current_page?(hotline_path)}" %></li>
          <li class="nav-item"><%= link_to "Support Form", support_path, class: "nav-link #{'active' if current_page?(support_path)}" %></li>
          </li>
        </ul>
      </div>
    </div>
  </nav>

  <main class="container flex-grow-1 py-4">
    <% if notice %>
      <div class="alert alert-success alert-dismissible fade show" role="alert">
        <%= notice %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
    <% end %>
    <% if alert %>
      <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <%= alert %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
    <% end %>

    <%= yield %>
  </main>

  <footer class="bg-dark text-white text-center py-3 mt-auto">
        <small>
      <script>
        document.write("&copy; " + new Date().getFullYear() + " Break the Silence. ");
      </script>
      Educational purposes only. In immediate danger? Call 999.
    </small>
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script>
    if ("IntersectionObserver" in window) {
      const io = new IntersectionObserver((entries) => {
        entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add("visible"); io.unobserve(e.target); } });
      }, { threshold: 0.1 });
      document.querySelectorAll("main .card, main h2, main .table-responsive, main .list-group")
        .forEach(el => { el.classList.add("reveal"); io.observe(el); });
    }
  </script>
</body>
</html>